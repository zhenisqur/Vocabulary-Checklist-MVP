<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/jpeg" href="/img/logo.jpeg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: #f0fdf4; 
            position: relative;
            overflow-x: hidden;
        }
        /* Наши фирменные пятна */
        .bg-gradient-spot {
            position: absolute;
            z-index: -1;
            width: 600px;
            height: 600px;
            filter: blur(120px);
            opacity: 0.3;
            border-radius: 100%;
        }
        .spot-1 { top: -100px; right: -100px; background: radial-gradient(circle, #10b981, #34d399); }
        .spot-2 { bottom: -150px; left: -100px; background: radial-gradient(circle, #6ee7b7, #a7f3d0); }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-6">

    <div class="bg-gradient-spot spot-1"></div>
    <div class="bg-gradient-spot spot-2"></div>

    <div class="w-full max-w-[460px]">
        <div class="flex flex-col items-center mb-10">
            <div class="w-[76px] h-[76px] rounded-2xl overflow-hidden shadow-xl shadow-emerald-200 mb-4 border border-white/20 backdrop-blur-md transition-all duration-300 hover:scale-110 hover:-rotate-6">
                <img src="/img/logo.jpeg" alt="Logo" class="w-full h-full object-cover">
            </div>
            
            <h2 class="text-xl font-black text-slate-800 tracking-tight mb-2">
                Vocabulary <span class="text-emerald-600">Checklist</span>
            </h2>

            <h1 class="text-3xl font-black text-slate-900 tracking-tight text-center">Создать аккаунт</h1>
            <p class="text-slate-400 font-medium mt-1 text-center text-sm"></p>
        </div>

        <div class="bg-white/80 backdrop-blur-xl p-10 rounded-[48px] shadow-[0_32px_80px_rgba(0,0,0,0.05)] border border-white transition-all duration-500 hover:shadow-[0_40px_100px_rgba(0,0,0,0.1)] hover:-translate-y-3 hover:scale-[1.01]">
            <form action="/register" method="POST" class="space-y-6">
                <div class="group">
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-[0.2em] mb-3 ml-1">Имя пользователя</label>
                    <input type="text" name="username" required 
                           class="w-full px-7 py-5 bg-slate-50 border-2 border-transparent rounded-[24px] focus:bg-white focus:border-emerald-600/10 focus:ring-4 focus:ring-emerald-600/5 transition-all outline-none font-semibold text-slate-700" 
                           placeholder="Например, Иван">
                </div>

                <div class="group">
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-[0.2em] mb-3 ml-1">Email</label>
                    <input type="email" name="email" required 
                           class="w-full px-7 py-5 bg-slate-50 border-2 border-transparent rounded-[24px] focus:bg-white focus:border-emerald-600/10 focus:ring-4 focus:ring-emerald-600/5 transition-all outline-none font-semibold text-slate-700" 
                           placeholder="your@email.com">
                </div>

                <div class="group">
                    <label class="block text-[11px] font-black text-slate-400 uppercase tracking-[0.2em] mb-3 ml-1">Пароль</label>
                    <input type="password" name="password" required 
                           class="w-full px-7 py-5 bg-slate-50 border-2 border-transparent rounded-[24px] focus:bg-white focus:border-emerald-600/10 focus:ring-4 focus:ring-emerald-600/5 transition-all outline-none font-semibold text-slate-700" 
                           placeholder="••••••••">
                </div>

                <button type="submit" 
                        class="w-full bg-[#064e3b] hover:bg-emerald-900 text-white py-5 rounded-[24px] font-black text-lg transition-all active:scale-[0.95] shadow-2xl shadow-emerald-900/20 mt-4 uppercase tracking-widest hover:shadow-emerald-900/40">
                    Зарегистрироваться
                </button>
            </form>

            <div class="mt-10 text-center border-t border-slate-50 pt-8">
                <p class="text-slate-400 font-semibold text-sm">
                    Уже в системе? <a href="/auth" class="text-emerald-600 hover:underline font-bold transition-colors">Войти в аккаунт</a>
                </p>
            </div>
        </div>
    </div>

</body>
</html>