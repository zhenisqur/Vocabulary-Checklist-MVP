<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/jpeg" href="/img/logo.jpeg">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f8fafc; position: relative; overflow-x: hidden; }
        body.emergency-active { background: radial-gradient(circle at center, #dc2626, #450a0a) !important; }
        .bg-gradient-spot { position: fixed; z-index: -1; width: 800px; height: 800px; filter: blur(140px); opacity: 0.25; border-radius: 100%; pointer-events: none; }
        .spot-1 { top: -200px; right: -100px; background: radial-gradient(circle, #10b981, #34d399); }
        .spot-2 { bottom: -300px; left: 100px; background: radial-gradient(circle, #6ee7b7, #a7f3d0); }
        .emergency-active .bg-gradient-spot { display: none; }
        .sidebar-item { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .sidebar-item:hover { background: rgba(16, 185, 129, 0.08); color: #059669; transform: translateX(4px); }
        .emergency-active .sidebar-item { color: #fecaca; }
        .emergency-active .sidebar-item:hover { background: rgba(255, 255, 255, 0.1); color: white; }
        .sidebar-active { background: #10b981 !important; color: white !important; box-shadow: 0 15px 30px -5px rgba(16, 185, 129, 0.3); }
        .emergency-active .sidebar-active { background: #ef4444 !important; box-shadow: 0 15px 30px -5px rgba(220, 38, 38, 0.4); }
        .sidebar-active svg { color: white !important; }
    </style>
</head>
<% const isEmergency = locals.theme === 'emergency' %>
<body class="flex min-h-screen <%= isEmergency ? 'emergency-active' : '' %>">

    <div class="bg-gradient-spot spot-1"></div>
    <div class="bg-gradient-spot spot-2"></div>

    <aside class="w-72 border-r flex flex-col fixed h-full z-50 transition-all duration-500 <%= isEmergency ? 'bg-red-950 border-red-900' : 'bg-white/80 backdrop-blur-xl border-emerald-50' %>">
        <div class="p-8 flex items-center gap-4">
            <img src="/img/logo.jpeg" alt="Logo" class="w-12 h-12 object-cover rounded-2xl shadow-lg border border-white/20">
            
            <span class="text-xl font-black tracking-tighter leading-[0.9] <%= isEmergency ? 'text-white' : 'text-slate-800' %>">Vocabulary<br><span class="<%= isEmergency ? 'text-red-500' : 'text-emerald-600' %>">Checklist</span></span>
        </div>

        <nav class="flex-grow px-4 space-y-2 mt-4">
            <% const currentPath = locals.path || '' %>
            <% const links = [
                { h: '/', n: 'Главная', i: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>' },
                { h: '/active', n: 'Живые', i: '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>' },
                { h: '/revive', n: 'Тренировка', i: '<polyline points="14.5 17.5 3 6 3 3 6 3 17.5 14.5"/><line x1="13" x2="19" y1="19" y2="13"/><line x1="16" x2="20" y1="16" y2="20"/><line x1="19" x2="21" y1="21" y2="19"/><polyline points="14.5 6.5 18 3 21 3 21 6 17.5 9.5"/><line x1="5" x2="9" y1="14" y2="18"/><line x1="7" x2="4" y1="17" y2="20"/><line x1="3" x2="5" y1="19" y2="21"/>' },
                { h: '/graveyard', n: 'Кладбище', i: '<path d="M12 2a8 8 0 0 0-8 8v12l3-3 2.5 2.5L12 19l2.5 2.5L17 19l3 3V10a8 8 0 0 0-8-8z"/><path d="M9 10h.01"/><path d="M15 10h.01"/>' },
                { h: '/library', n: 'Библиотека', i: '<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>' },
                { h: '/words', n: 'Словарь', i: '<path d="M12 21V7"/><path d="m16 12 2 2 4-4"/><path d="M22 6V4a1 1 0 0 0-1-1h-5a4 4 0 0 0-4 4 4 4 0 0 0-4-4H3a1 1 0 0 0-1 1v13a1 1 0 0 0 1 1h6a3 3 0 0 1 3 3 3 3 0 0 1 3-3h6a1 1 0 0 0 1-1v-1.3"/>' }
            ] %>
            <% links.forEach(link => { %>
                <a href="<%= link.h %>" class="sidebar-item group flex items-center gap-4 px-6 py-4 rounded-[24px] font-bold transition-all <%= currentPath === link.h ? 'sidebar-active' : (isEmergency ? 'text-red-200/50' : 'text-slate-400') %>">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><%- link.i %></svg>
                    <span><%= link.n %></span>
                </a>
            <% }) %>
        </nav>

        <div class="p-6 border-t <%= isEmergency ? 'border-red-900' : 'border-emerald-50' %>">
            <a href="/profile" class="group block">
                <div class="rounded-[32px] p-4 flex items-center gap-4 border transition-all group-active:scale-95 <%= isEmergency ? 'bg-red-900/40 border-red-800 hover:bg-red-900/60' : 'bg-emerald-50/50 border-emerald-100/50 hover:bg-emerald-100' %>">
                    <div class="w-12 h-12 rounded-2xl overflow-hidden border-2 border-white shadow-md bg-emerald-100">
                        <img 
                            src="<%= locals.avatarUrl || '/img/default-profile.jpeg' %>" 
                            alt="Profile"
                            class="w-full h-full object-cover"
                            onerror="this.src='/img/default-profile.jpeg?v=' + Date.now()"
                            loading="lazy"
                        >
                    </div>
                    <div class="overflow-hidden">
                        <p class="text-[10px] font-black uppercase tracking-[0.2em] <%= isEmergency ? 'text-red-400' : 'text-emerald-600/50' %>">Профиль</p>
                        <p class="text-sm font-black truncate <%= isEmergency ? 'text-white' : 'text-slate-700' %>"><%= locals.username || 'Zhenis' %></p>
                    </div>
                </div>
            </a>
        </div>
    </aside>

    <main class="ml-72 flex-grow p-12 relative">
        <%- body %>
    </main>

</body>
</html>