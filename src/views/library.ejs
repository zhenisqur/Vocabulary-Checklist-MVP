<main class="p-8 md:p-12 space-y-10 relative">
    <div class="flex flex-col gap-2">
        <h1 class="text-4xl font-black text-slate-900 tracking-tight text-uppercase">Библиотека</h1>
        <div class="flex items-center gap-2">
            <span class="px-3 py-1 bg-emerald-100 text-emerald-700 rounded-full text-[10px] font-black uppercase tracking-widest italic">Base</span>
            <p class="text-emerald-600 font-bold text-sm uppercase">Доступно: <%= libraryWords.length %> слов</p>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        <% if (libraryWords && libraryWords.length > 0) { %>
            <% libraryWords.forEach(word => { %>
                <div class="bg-white p-8 rounded-[48px] border border-slate-50 shadow-[0_20px_50px_rgba(0,0,0,0.04)] transition-all duration-300 hover:-translate-y-2 hover:shadow-xl active:scale-95 group">
                    
                    <div class="flex justify-between items-start mb-6">
                        <div class="flex items-center gap-2">
                            <span class="px-3 py-1 bg-emerald-100/70 text-emerald-700 rounded-full text-[10px] font-black uppercase tracking-widest">Library</span>
                            <div class="w-8 h-8 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-600 font-black text-sm group-hover:bg-emerald-500 group-hover:text-white transition-all">
                                <%= word.level || 'A1' %>
                            </div>
                        </div>
                        <span class="text-[10px] font-black text-slate-300 uppercase tracking-widest"></span>
                    </div>

                    <h3 class="text-3xl font-black text-slate-800 tracking-tighter uppercase"><%= word.english %></h3>
                    <p class="text-slate-500 font-medium text-sm mt-1 underline decoration-emerald-200 underline-offset-4"><%= word.russian %></p>
                    
                    <form action="/add-from-library" method="POST" class="mt-8 library-form">
                        <input type="hidden" name="english" value="<%= word.english %>">
                        <input type="hidden" name="russian" value="<%= word.russian %>">
                        
                        <button type="submit" class="w-full py-4 bg-slate-900 text-white rounded-2xl font-black text-xs uppercase tracking-wider transition-all hover:bg-emerald-600 active:scale-90 shadow-lg shadow-slate-200">
                            Оживить
                        </button>
                    </form>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-span-full py-20 text-center">
                <p class="text-slate-400 font-bold">Библиотека пуста. Проверь файл dictionary.json!</p>
            </div>
        <% } %>
    </div>

    <script>
    document.querySelectorAll('.library-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const formData = new URLSearchParams(new FormData(form));
            const button = form.querySelector('button');
            const card = form.closest('.group');

            const originalText = button.innerText;
            button.innerText = 'ОЖИВЛЯЕМ...';
            button.disabled = true;

            try {
                const response = await fetch('/add-from-library', {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    }
                });

                if (response.ok) {
                    // Анимация улетающей карточки вверх
                    card.style.transition = 'all 0.6s cubic-bezier(0.4, 0, 0.2, 1)';
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(-40px) scale(0.9)';
                    
                    setTimeout(() => {
                        card.remove();
                    }, 600);
                } else {
                    button.innerText = 'ОШИБКА';
                    button.style.backgroundColor = '#ef4444'; // Red
                    setTimeout(() => {
                        button.innerText = originalText;
                        button.style.backgroundColor = '';
                        button.disabled = false;
                    }, 2000);
                }
            } catch (err) {
                console.error('Ошибка:', err);
                button.innerText = 'СЕРВЕР DOWN';
                button.disabled = false;
            }
        });
    });
    </script>
</main>