<div class="max-w-4xl mx-auto space-y-10 pb-20">
    <div class="bg-white/60 backdrop-blur-xl rounded-[40px] p-8 flex flex-col md:flex-row items-center gap-8 border border-white shadow-xl shadow-emerald-100/20">
        <div class="relative group">
            <form action="/profile/upload-avatar" method="POST" enctype="multipart/form-data" id="avatarForm">
                <label class="cursor-pointer block">
                    <div class="w-32 h-32 rounded-[35px] overflow-hidden border-4 border-white shadow-2xl transition-all group-hover:brightness-75 group-hover:scale-105">
                        <img 
                            src="<%= (typeof user !== 'undefined' && user.avatarUrl) ? user.avatarUrl : '/img/default-profile.jpeg' %>" 
                            class="w-full h-full object-cover" 
                            id="avatarPreview"
                            onerror="this.src='/img/default-profile.jpeg?v=' + Date.now()"
                        >
                        <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                        </div>
                    </div>
                    <input type="file" name="avatar" class="hidden" onchange="document.getElementById('avatarForm').submit()">
                </label>
            </form>
            <div class="absolute -bottom-2 -right-2 bg-emerald-500 text-white px-3 py-1 rounded-2xl shadow-lg border-2 border-white font-bold text-sm">
                <% let currentActive = (typeof activeCount !== 'undefined') ? activeCount : 0; %>
                Lv.<%= (currentActive >= 100) ? Math.floor((currentActive - 100) / 50) + 4 : (currentActive >= 50 ? 3 : (currentActive >= 20 ? 2 : 1)) %>
            </div>
        </div>

        <div class="flex-grow text-center md:text-left">
            <h1 class="text-4xl font-black text-slate-800 tracking-tight mb-2"><%= (typeof user !== 'undefined') ? user.name : 'Пользователь' %></h1>
            <p class="text-slate-500 font-medium mb-4">Твоя лингвистическая империя растет!</p>
            <div class="flex flex-wrap justify-center md:justify-start gap-3">
                <div class="px-4 py-2 bg-emerald-50 text-emerald-600 rounded-2xl font-bold text-sm border border-emerald-100">7 дней ударно</div>
                <div class="px-4 py-2 bg-blue-50 text-blue-600 rounded-2xl font-bold text-sm border border-blue-100"><%= currentActive %> слов в живых</div>
            </div>
        </div>

        <div class="md:ml-auto">
            <a href="/logout" class="px-6 py-4 bg-rose-50 text-rose-500 rounded-[24px] font-bold hover:bg-rose-100 transition-all border border-rose-100">Выйти</a>
        </div>
    </div>

    <div class="space-y-12">
        <h2 class="text-3xl font-black text-slate-800 text-center uppercase tracking-tighter">Твой путь к мастерству</h2>
        
        <div class="relative py-10 max-w-4xl mx-auto"> <svg class="absolute top-0 left-0 w-full h-full opacity-30 pointer-events-none z-0" viewBox="0 0 400 1000" preserveAspectRatio="none">
                <path d="M100,0 Q350,150 100,300 T100,600 T100,900" fill="none" stroke="#10b981" stroke-width="6" stroke-dasharray="12" stroke-linecap="round" />
            </svg>

            <% 
                const levels = [
                    { id: 1, req: 20, title: "Хорош" },
                    { id: 2, req: 50, title: "Красавчик" },
                    { id: 3, req: 100, title: "Мужик" },
                    { id: 4, req: 150, title: "Пахан" },
                    { id: 5, req: 200, title: "Англичанин" },
                    { id: 6, req: 250, title: "Машина" },
                    { id: 7, req: 300, title: "Тигр" },
                    { id: 8, req: 350, title: "Лев" },
                    { id: 9, req: 400, title: "Ниндзя" },
                    { id: 10, req: 450, title: "Легенда" },
                    { id: 11, req: 500, title: "Мастер" },
                    { id: 12, req: 550, title: "Грандмастер" },
                    { id: 13, req: 600, title: "Пророк" },
                    { id: 14, req: 650, title: "Босс" },
                    { id: 15, req: 700, title: "Шекспир" },
                    { id: 16, req: 750, title: "Философ" },
                    { id: 17, req: 800, title: "Атлант" },
                    { id: 18, req: 850, title: "Титаниум" },
                    { id: 19, req: 900, title: "Бессмертный" },
                    { id: 20, req: 1000, title: "Бог Языка" }
                ];

                let passedCount = levels.filter(l => currentActive >= l.req).length;
            %>

            <div class="flex flex-col gap-24 relative z-10">
                <% levels.forEach((lvl, index) => { 
                    const isPassed = currentActive >= lvl.req;
                    const isCurrent = (passedCount === index + 1) || (passedCount === 0 && index === 0 && currentActive < levels[0].req);
                    
                    const positions = ['justify-start md:pl-20', 'justify-end md:pr-20']; // Добавил отступы для зигзага
                    const currentPos = positions[index % 2];
                %>
                    <div class="flex w-full <%= currentPos %> px-6">
                        <div class="relative group flex flex-col items-center">
                            
                            <div class="w-40 h-40 rounded-full flex flex-col items-center justify-center shadow-2xl border-8 border-white transition-all duration-500
                                <%= isPassed ? 'bg-emerald-500 text-white shadow-emerald-200' : 'bg-white text-slate-200 border-slate-100 shadow-slate-100' %>
                                <%= isCurrent ? 'scale-125 ring-[12px] ring-emerald-100 z-30' : 'z-20' %>">
                                
                                <span class="text-xs font-black opacity-70 uppercase leading-none">Уровень</span>
                                <span class="text-5xl font-black mb-2"><%= lvl.id %></span>
                                
                                <div class="px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-wider whitespace-nowrap shadow-md
                                    <%= isPassed ? 'bg-white text-emerald-600' : 'bg-slate-800 text-white' %>">
                                    <%= lvl.title %>
                                </div>
                            </div>

                            <% if (!isPassed) { %>
                                <div class="absolute -bottom-12 bg-white/90 backdrop-blur shadow-lg border border-slate-100 px-4 py-2 rounded-xl text-xs font-bold text-slate-500 whitespace-nowrap">
                                    Нужно еще <%= lvl.req - currentActive %>
                                </div>
                            <% } %>

                            <% if (isCurrent) { %>
                                <div class="absolute -top-14 bg-emerald-600 text-white px-4 py-2 rounded-2xl text-xs font-black uppercase animate-bounce shadow-xl">
                                    Твой статус!
                                    <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-3 h-3 bg-emerald-600 rotate-45"></div>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>
    </div>
</div>