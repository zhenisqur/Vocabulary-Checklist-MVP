<div class="max-w-4xl mx-auto space-y-10 animate-in">
    
    <div class="bg-white/80 backdrop-blur-xl p-8 rounded-[45px] border border-emerald-50 shadow-sm flex items-center justify-between">
        <div class="flex items-center gap-6">
            <form id="avatarForm" action="/profile/upload-avatar" method="POST" enctype="multipart/form-data">
                <input type="file" id="avatarInput" name="avatar" class="hidden" onchange="document.getElementById('avatarForm').submit()">
                <div class="relative group cursor-pointer" onclick="document.getElementById('avatarInput').click()">
                    <div class="w-24 h-24 rounded-[30px] overflow-hidden border-4 border-white shadow-lg group-hover:opacity-80 transition-all">
                        <img 
                            src="<%= user.avatarUrl || '/img/default-profile.jpeg' %>" 
                            class="w-full h-full object-cover"
                            onerror="this.src='/img/default-profile.jpeg?v=' + Date.now()"
                        >
                        <div class="absolute inset-0 bg-black/20 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
                        </div>
                    </div>
                    <div class="absolute -bottom-2 -right-2 w-8 h-8 bg-emerald-500 rounded-xl border-4 border-white flex items-center justify-center text-[10px] font-black text-white shadow-md">
                        <% 
                            // Динамический расчет уровня: каждые 50 слов = 1 уровень
                            let wordsPerLevel = 50;
                            let calcLevel = Math.floor(activeCount / wordsPerLevel) + 1;
                            if (calcLevel > 20) calcLevel = 20;
                        %>
                        <%= calcLevel %>
                    </div>
                </div>
            </form>

            <div>
                <h1 class="text-3xl font-black text-slate-800 tracking-tighter"><%= user.name %></h1>
                <div class="flex gap-2 mt-2">
                    <span class="px-3 py-1 bg-emerald-50 text-emerald-600 rounded-full text-[10px] font-black uppercase tracking-wider">Уровень <%= calcLevel %> / 20</span>
                    <span class="px-3 py-1 bg-blue-50 text-blue-600 rounded-full text-[10px] font-black uppercase tracking-wider"><%= activeCount %> слов</span>
                </div>
            </div>
        </div>
        
        <form action="/logout" method="POST">
            <button class="px-6 py-3 bg-red-50 text-red-400 hover:bg-red-100 rounded-2xl font-black text-xs uppercase tracking-widest transition-all">Выйти</button>
        </form>
    </div>

    <div class="text-center py-4">
        <h2 class="text-2xl font-black text-slate-800 uppercase tracking-tight">Твой путь к мастерству</h2>
    </div>

    <div class="relative flex flex-col items-center pb-20">
        <div class="absolute top-0 bottom-0 w-1.5 bg-slate-100 rounded-full left-1/2 -translate-x-1/2">
            <div class="bg-emerald-500 w-full transition-all duration-1000" 
                 id="levelProgressBar"
                 data-level-progress="<%= (calcLevel / 20) * 100 %>"></div>
        </div>
        
        <% 
            const levelTitles = ["Хорош", "Красавчик", "Мужик", "Пахан", "Англичанин", "Машина", "Тигр", "Лев", "Ниндзя", "Легенда", "Мастер", "Грандмастер", "Пророк", "Босс", "Шекспир", "Философ", "Атлант", "Титаниум", "Бессмертный", "Бог Языка"];
        %>

        <% for(let i = 1; i <= 20; i++) { %>
            <% 
                let isCompleted = i < calcLevel;
                let isCurrent = i === calcLevel;
                let statusClass = isCompleted ? 'bg-emerald-500 text-white border-emerald-200' : 
                                 isCurrent ? 'bg-white border-emerald-500 text-emerald-500 scale-125 shadow-2xl z-20' : 
                                 'bg-white border-slate-100 text-slate-200';
                
                let zigZagClass = i % 2 !== 0 ? 'md:-translate-x-20' : 'md:translate-x-20';
                
                // Расчет сколько нужно слов именно для этого уровня i
                let wordsForThisLevel = i * wordsPerLevel;
                let neededToReach = wordsForThisLevel - activeCount;
            %>
            
            <div class="relative z-10 flex flex-col items-center mb-24 last:mb-0 transition-transform duration-500 <%= zigZagClass %>">
                
                <div class="w-16 h-16 rounded-full border-[6px] shadow-xl flex items-center justify-center text-xl font-black transition-all <%= statusClass %>">
                    <%= i %>
                </div>

                <div class="absolute -bottom-10 px-3 py-1 bg-white border border-slate-100 shadow-sm rounded-lg text-[9px] font-black uppercase tracking-tight whitespace-nowrap <%= isCompleted ? 'text-emerald-600' : 'text-slate-400' %>">
                    <%= levelTitles[i-1] %> (<%= wordsForThisLevel %> сл.)
                </div>

                
            </div>
        <% } %>
    </div>
</div>

<style>
    @keyframes bounce-horizontal {
        0%, 100% { transform: translateX(0); }
        50% { transform: translateX(10px); }
    }
    .animate-bounce-horizontal { animation: bounce-horizontal 2s infinite ease-in-out; }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const bar = document.getElementById('levelProgressBar');
        if(bar) {
            bar.style.height = bar.getAttribute('data-level-progress') + '%';
        }
    });
</script>